{
    "version": 2,
    "name": "splash-page",
    "routes": [
      { "src": "/css/(.*)", "headers": { "cache-control": "public, max-age=86400" }, "continue": true },
      { "src": "/(img|fonts)/(.*)", "headers": { "cache-control": "public, max-age=2592000" }, "continue": true },
      { "src": "/favicon.ico", "headers": { "cache-control": "public, max-age=86400" }, "continue": true },
      { "handle": "filesystem" },
      { "src": "/(.*)", "dest": "api/server.js" }
    ]
 }
